{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node",
    "outDir": ".probe-build",
    "rootDir": "lib",
    "strict": true,
    "skipLibCheck": true,
    "declaration": false,
    "esModuleInterop": true
  },
  "include": ["lib/**/*.ts"]
}
