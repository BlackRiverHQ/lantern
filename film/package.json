{
  "name": "film",
  "version": "1.0.0",
  "description": "Lantern launch film: one GSAP timeline, Three.js for the 3D, rendered frame by frame.",
  "scripts": {
    "setup": "npx playwright install chromium",
    "render": "node tools/render.mjs --page src/index.html --out out/lantern-picture.mp4 --fps 60 --sub 4 --to 30 --jpeg",
    "render:fast": "node tools/render.mjs --page src/index.html --out out/lantern-picture.mp4 --fps 30 --sub 1 --to 30 --jpeg",
    "mix": "python3 tools/offline-mix.py out/lantern-picture.mp4 out/lantern-16x9.mp4",
    "preview": "python3 -m http.server 8090"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "gsap": "^3.15.0",
    "playwright": "^1.63.0",
    "three": "^0.186.1"
  }
}
