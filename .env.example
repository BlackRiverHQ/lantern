# Copy to .env and fill in. Never commit a filled .env.
#
# One testnet key with gas only. Every script signs with it, so it is the deployer, the operator on
# the feeds, and the liquidator named in the demo.
#
# PRIVATE_KEY may be left empty if you use script/with-account.sh, which reads the key from a file
# outside the repository and passes it into the environment without ever printing it:
#
#   cast wallet new --json > ~/.lantern-deployer.json && chmod 600 ~/.lantern-deployer.json
#   make redeploy-account            # or: ./script/with-account.sh ./script/redeploy.sh
#
PRIVATE_KEY=
RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# script/Deploy.s.sol
FEED_ID=
HOLD_WINDOW=300
BOUNTY_BPS=2000

# Everything after the deploy takes the addresses the deploy made. script/redeploy.sh fills these in
# from the broadcast record; by hand, take them from its output or from deployments.json.
LANTERN=
MARKET=

# Feeds. The defaults are the recorded deployment's, and both are keccak of the string shown.
# Subject: keccak("FEED:ARB-SEPOLIA-DEMO"); peer: keccak("FEED:ETH-USD-PEER").
SUBJECT_FEED_ID=
PEER_FEED_ID=

# Scenario knobs, all optional.
ROUND=7                       # which round the peer's Chainlink answer is placed at
BONUS=1000000000000000000     # the bonus under test, 1 unit
BOND=1000000000000000000      # the peer feed's bond, 1 unit
LIQUIDATION_ID=9              # the liquidation the Chainlink challenge is opened against
AGGREGATOR=                   # defaults to Chainlink ETH/USD on this chain

# Verification only. foundry.toml reads ARBISCAN_API_KEY for the arbitrum_sepolia endpoint.
ARBISCAN_API_KEY=
